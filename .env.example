# Copy to .env and fill in. .env is gitignored; never commit real secrets.
#
# Values below are for running apps on the HOST with `pnpm dev` (localhost URLs).
# Inside docker compose, services reach each other by service name (postgres, judge, server, web);
# docker-compose.yml sets those container-side values itself.

# --- Postgres (docker compose `postgres` service) ---
POSTGRES_USER=rr
POSTGRES_PASSWORD=rr_dev_password
POSTGRES_DB=runtime_rivals
POSTGRES_PORT=5433

# --- apps/server (arrives in M2) ---
PORT=4000
DATABASE_URL=postgresql://rr:rr_dev_password@localhost:5433/runtime_rivals
# Piston judge API (compose exposes it on localhost only)
JUDGE_API_URL=http://localhost:2000
# Comma-separated list of browser origins allowed to call the server
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Signs guest-session cookies. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Liveblocks secret key (sk_...) from https://liveblocks.io/dashboard — needed from M7
LIVEBLOCKS_SECRET_KEY=

# --- apps/web (inlined into the browser bundle at build time) ---
# Empty = same origin as the page, which is what you want behind Caddy (http://localhost:8080)
# or a Cloudflare tunnel. When running web and server separately on the host, use
# NEXT_PUBLIC_API_URL=http://localhost:4000 and NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# --- Caddy (single public origin) ---
CADDY_PORT=8080
